=== react | <FIGMA_MOT_DE_PASSE__> | Nouveau mot de passe=False
const nativeInputProps = { autoComplete: 'current-password' };
const messages = [
  { severity: 'info', message: '12 caractères minimum' },
  { severity: 'info', message: '1 caractère spécial minimum' },
  { severity: 'info', message: '1 chiffre minimum' }
];

<PasswordInput
  label="Mot de passe"
  nativeInputProps={nativeInputProps}
  messages={messages}
/>

