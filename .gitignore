# Dépendances
**/node_modules/

# Secrets : le token Figma ne doit JAMAIS être versionné
**/.env/
**/*token*
.env
!.env.example
*.env

# Lots et configs générés par scripts/catalog.mjs
.codeconnect/

# Propre à chaque utilisateur : clés de ses copies de fichiers Figma et catalogue d'icônes généré
figma.local.json
components/icon/icon.json
components/icon/icon.snap

# Logs / divers
*.log
.DS_Store

# Rapport généré par le script de rebranchement
rebind-report.json

# App desktop : artefacts de build (régénérés par prepare-resources.js / electron-builder)
desktop/resources/manifest.json
desktop/resources/rebind-to-your-file.mjs
desktop/resources/stacks.json
desktop/src/renderer/dsfr/
desktop/release/

# Worktrees des sous-agents (locaux, jamais versionnés)
.claude/worktrees/
